/target
**/*.rs.bk
# cargo-fuzz artifacts
fuzz/target
fuzz/corpus
fuzz/artifacts
# coverage reports/artifacts (the tracked inventories are un-ignored below)
/coverage/*
!/coverage/wml-elements.toml
!/coverage/stage5-scenarios.toml
!/coverage/render-gates.toml
*.profraw
# local .docx working corpus (not published in the repository)
# note: strict-ooxml-core/tests/samples/ is the PUBLIC synthetic corpus and is
# tracked on purpose; only the local tests/docx/ corpus is ignored here.
strict-ooxml-core/tests/docx/
# Stage-5C sample deliveries (STAGE-5C-REWORK-1 D5): the ZIP archives are NOT
# committed - only the individual packages that ended up in
# strict-ooxml-core/tests/strict/ (see that directory's README for provenance).
/strict-ooxml-samples.zip
/strict-ooxml-samples2.zip
# a stray copy of a corpus fixture at the repository root
/10-strict-math-eqarr.docx
# The foreign PDF corpus (Q-9): 46 files, 600+ MiB, licences and provenance
# still to be decided by the file owner. It is NOT part of the build, and
# `strict-ooxml-pdf/examples/corpus_report.rs` is a manual instrument precisely
# because a test that silently skips a missing directory cannot fail.
# The permanent guard against what the corpus found lives in
# `strict-ooxml-pdf/tests/resources.rs` and `tests/raster.rs`.
/testdata/
# scratch output of the browser driver (screenshots, snapshots, console logs)
/.playwright-mcp/

# a hard link to one corpus file, for timing one document repeatedly
/.tmp-bench/

# page_diff's default output directory
/.page-diff/

# the XSD gate is a Python tool, and Python writes bytecode next to it
__pycache__/
*.pyc
